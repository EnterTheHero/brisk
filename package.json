{
  "name": "brisk-browser",
  "version": "0.5.4",
  "description": "A lightweight, private Chromium-based browser with built-in ad and tracker blocking and Google Drive sync.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": "EnterTheHero",
  "license": "MIT",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3"
  },
  "productName": "Brisk",
  "build": {
    "appId": "com.brisk.browser",
    "productName": "Brisk",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "Brisk",
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationUsageDescription": "Websites you allow can see your location.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.html"
            ]
          }
        ]
      },
      "artifactName": "Brisk-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Brisk",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Brisk-Setup-${version}.exe"
    },
    "publish": null,
    "squirrelWindows": {
      "loadingGif": "build/install-spinner.gif",
      "artifactName": "Brisk-Setup-${version}.${ext}",
      "useAppIdAsId": false,
      "name": "Brisk",
      "iconUrl": "https://raw.githubusercontent.com/EnterTheHero/brisk/main/build/icon.ico"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EnterTheHero/brisk.git"
  },
  "homepage": "https://github.com/EnterTheHero/brisk"
}
